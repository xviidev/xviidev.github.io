{
  "name": "xviidev",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev -w @xviidev/utilities",
    "check": "npm run check:ui && npm run check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "node scripts/build.mjs",
    "preview": "vite preview --config scripts/preview.config.ts",
    "check:ui": "node scripts/check-ui.mjs",
    "dev:web": "npm run dev -w @xviidev/web -- --host 127.0.0.1"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "vite": "^8.3.5"
  }
}
