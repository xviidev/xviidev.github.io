---
import '../styles/global.css';
import UtilityApp from '../components/UtilityApp';
interface Props { title?: string; description?: string; }
const { title = 'Utilitas — XVII Dev', description = 'Alat sederhana untuk pekerjaan sehari-hari. Langsung di browser.' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="id" class="bg-background text-foreground">
 <head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#ffffff" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="id_ID" />
  <link rel="icon" type="image/png" href="/favicon-32x32.png" />
  <script is:inline>
   try { const dark = localStorage.getItem('xvii-utilities-theme') === 'dark'; document.documentElement.classList.toggle('dark', dark); document.documentElement.style.colorScheme = dark ? 'dark' : 'light'; } catch {}
  </script>
 </head>
 <body class="font-mono text-sm leading-relaxed [font-synthesis:none]">
  <UtilityApp client:only="react" />
  <noscript>Aktifkan JavaScript untuk menggunakan utilitas ini.</noscript>
 </body>
</html>
