{
  "name": "xviidev",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@xviidev/web -- --host 127.0.0.1",
    "check": "npm run check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspace=@xviidev/web",
    "preview": "npm run preview --workspace=@xviidev/web -- --host 127.0.0.1"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "vite": "^8.3.5"
  }
}
